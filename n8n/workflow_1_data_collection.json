            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Quality Success?": {
      "main": [
        [
          {
            "node": "Save Market Metrics",
            "type": "main",
            "index": 0
          },
          {
            "node": "Save Liquidity Indicators",
            "type": "main",
            "index": 0
          },
          {
            "node": "Save Stablecoins",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Log Validation Error",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Save Market Metrics": {
      "main": [
        [
          {
            "node": "Log Success UTC",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Save Liquidity Indicators": {
      "main": [
        [
          {
            "node": "Log Success UTC",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Save Stablecoins": {
      "main": [
        [
          {
            "node": "Log Success UTC",
            "type": "main",
