            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionTimeout": 300,
    "saveExecutionProgress": true,
    "saveManualExecutions": true,
    "timezone": "UTC"
  },
  "active": false,
  "versionId": "workflow-1-data-collection-v1",
  "meta": {
    "phase": 17,
    "workflow": 1,
    "standardNodesOnly": true,
    "futureWorkflowsIncluded": false
  }
}
