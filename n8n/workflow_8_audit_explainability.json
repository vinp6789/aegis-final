        "sendBody": true,
        "contentType": "json",
        "jsonBody": "={\"timestamp\":\"{{$now.toUTC().toISO()}}\",\"workflow\":\"workflow_8_audit_explainability\",\"alert_type\":\"audit_explainability_anomaly\",\"additive_conservation_checked\":true,\"traceability_report_generated\":true}",
        "options": {
