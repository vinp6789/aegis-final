        "postgres": {
          "id": "aegis-timescaledb",
          "name": "Aegis TimescaleDB"
        }
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 5000,
      "continueOnFail": true
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT COALESCE(MAX((bad_value_raw::jsonb ->> 'psi')::NUMERIC), 0.0) AS latest_psi, COALESCE(MAX(CASE WHEN exception_type = 'GOVERNANCE_RETRAINING_TRIGGER' THEN 1 ELSE 0 END), 0) AS retraining_triggered FROM data_quality_exceptions WHERE source_name = 'governance_engine' AND timestamp >= (NOW() AT TIME ZONE 'UTC') - INTERVAL '30 days';"
      },
      "id": "fetch-governance-trigger",
      "name": "Fetch Governance Trigger",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2,
      "position": [
        500,
        -120
      ],
      "credentials": {
        "postgres": {
          "id": "aegis-timescaledb",
          "name": "Aegis TimescaleDB"
        }
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 5000,
      "continueOnFail": true
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT COUNT(*) AS feature_rows FROM probability_matrix_outputs_v3 WHERE timestamp >= (NOW() AT TIME ZONE 'UTC') - INTERVAL '180 days';"
      },
      "id": "fetch-training-readiness",
      "name": "Fetch Training Readiness",
      "type": "n8n-nodes-base.postgres",
