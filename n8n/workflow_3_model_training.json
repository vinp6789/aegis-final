      "maxTries": 3,
      "waitBetweenTries": 5000,
      "continueOnFail": true
    },
    {
      "parameters": {
        "conditions": {
          "boolean": [
            {
              "value1": "={{$json.retraining_triggered === 1 || $json.latest_psi >= 0.25}}",
              "value2": true
            }
          ]
        }
      },
